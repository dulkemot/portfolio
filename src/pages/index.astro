---
import Base from '../layouts/Base.astro';
import { profile, skills, projects } from '../data/projects.js';
---
<Base title="dulkemot — Astro + JS Developer">
<div class="hero">
<div class="badge">{profile.location} • OPEN FOR FREELANCE</div>
<h1>Halo, saya <span>dulkemot</span>.<br />{profile.role}</h1>
<p class="lead">{profile.tagline} Fokus: website company profile yang cepat dibuka di HP, gampang diupdate tanpa CMS.</p>
<p><a class="btn" href="mailto:{profile.email}">Hubungi Saya →</a><a class="btn ghost" href="https://github.com/dulkemot">GitHub →</a></p>
</div>

<h2>Skills</h2>
<div class="skills"><img src={`https://skillicons.dev/icons?i=${skills.join(',')}`} alt="skills" /></div>

<h2 style="margin-top:32px">Projects</h2>
<div class="grid">
{projects.map(p => (
<div class="card"><h3>{p.title}</h3>
<div class="tags">{p.stack.join(' • ')}</div>
<p>{p.desc}</p>
<ul>{p.points.map(pt => <li>{pt}</li>)}</ul>
</div>))}
</div>

<h2 style="margin-top:32px">Kenapa Astro?</h2>
<p class="lead">Static output = murah hosting, cepat di HP kentang, SEO gampang. Data produk cukup di 1 file JS, tidak perlu database untuk company profile / katalog.</p>
</Base>
