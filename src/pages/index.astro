---
import Base from '../layouts/Base.astro';
import { profile, skills, services, projects } from '../data/projects.js';
---
<Base title="dulkemot — Astro + JS Developer">
<div class="hero">
<div class="badge"><span class="dot"></span>{profile.location} • OPEN FOR FREELANCE</div>
<h1>Halo, saya <span>dulkemot</span>.<br />{profile.role}</h1>
<p class="lead">{profile.tagline} Fokus: website company profile yang cepat dibuka di HP, gampang diupdate tanpa CMS.</p>
<p><a class="btn" href={profile.wa}>Hubungi Saya →</a><a class="btn ghost" href="https://github.com/dulkemot">GitHub →</a></p>
</div>

<h2 class="sec">Layanan</h2>
<p class="sub">Yang biasa saya kerjakan untuk klien.</p>
<div class="grid" style="grid-template-columns:1fr 1fr 1fr">
{services.map(s => <div class="svc"><b>{s.t}</b><p>{s.d}</p></div>)}
</div>

<h2 class="sec">Skills</h2>
<p class="sub">Senjata sehari-hari.</p>
<div class="skills"><img src={`https://skillicons.dev/icons?i=${skills.join(',')}`} alt="skills" loading="lazy" /></div>

<h2 class="sec">Projects</h2>
<p class="sub">Pilih yang live — semuanya bisa dibuka.</p>
<div class="grid">
{projects.map(p => (
<div class="card"><h3>{p.title}</h3>
<div class="tags">{p.stack.join(' • ')}</div>
<p>{p.desc}</p>
<ul class="points">{p.points.map(pt => <li>{pt}</li>)}</ul>
<p><a class="btn small" href={p.demo}>Live Demo →</a><a class="btn small ghost" href={p.code}>Code →</a></p>
</div>))}
</div>

<h2 class="sec">Stats</h2>
<p class="sub">Aktivitas GitHub saya.</p>
<div class="stats">
<img width="390" src="https://github-readme-stats.vercel.app/api?username=dulkemot&show_icons=true&count_private=true&theme=transparent" alt="stats" loading="lazy" />
<img width="390" src="https://github-readme-streak-stats.herokuapp.com/?user=dulkemot&theme=transparent" alt="streak" loading="lazy" />
</div>

<h2 class="sec">Kenapa Astro?</h2>
<p class="lead">Static output = murah hosting, cepat di HP kentang, SEO gampang. Data produk cukup di 1 file JS, tidak perlu database untuk company profile / katalog.</p>

<div class="cta">
<h2>Ada project website?</h2>
<p>Ceritakan kebutuhanmu — company profile, katalog, atau landing page.</p>
<p><a class="btn" href={profile.wa}>Chat WhatsApp →</a><a class="btn ghost" href="https://github.com/dulkemot">Lihat GitHub →</a></p>
</div>
</Base>
